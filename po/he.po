#: ../fontforge/splinestroke.c:577
msgid "The contour winds counter-clockwise; a nib must wind clockwise."
msgstr "קו המתאר מתפתל נגד כיוון השעון; ראש עט (nib) חייב להתפתל עם כיוון השעון."

#: ../fontforge/splinestroke.c:580
msgid "The contour bends or curves counter-clockwise at the selected point; all on-curve points must bend or curve clockwise."
msgstr "קו המתאר מתכופף או מתעקל נגד כיוון השעון בנקודה שנבחרה; כל הנקודות על העקומה חייבות להתכופף או להתעקל עם כיוון השעון."

#: ../fontforge/splinestroke.c:584
msgid "The selected point is on a line; all on-curve points must bend or curve clockwise."
msgstr "הנקודה שנבחרה נמצאת על קו; כל הנקודות על העקומה חייבות להתכופף או להתעקל עם כיוון השעון."

#: ../fontforge/splinestroke.c:587
msgid "A nib must have at least three on-curve points."
msgstr "לראש עט חייבות להיות לפחות שלוש נקודות על העקומה."

#: ../fontforge/splinestroke.c:589
msgid "The contour is quadratic; a nib must be a cubic contour."
msgstr "קו המתאר ריבועי; ראש עט חייב להיות קו מתאר קובי."

#: ../fontforge/splinestroke.c:591
msgid "The contour is open; a nib must be closed."
msgstr "קו המתאר פתוח; ראש עט חייב להיות סגור."

#: ../fontforge/splinestroke.c:593
msgid "The selected point is the start of a 'tiny' spline; splines that small may cause inaccurate calculations."
msgstr "הנקודה שנבחרה היא תחילתו של Spline 'זעיר'; Splines קטנים כל כך עלולים לגרום לחישובים לא מדויקים."

#: ../fontforge/splinestroke.c:596
msgid "The selected point starts a spline with one control point; nib splines need a defined slope at both points."
msgstr "הנקודה שנבחרה מתחילה Spline עם נקודת בקרה אחת; Splines של ראש עט צריכים שיפוע מוגדר בשתי הנקודות."

#: ../fontforge/splinestroke.c:599
msgid "The selected control point's position violates Rule 1 (see documentation)."
msgstr "מיקום נקודת הבקרה שנבחרה מפר את כלל 1 (ראה תיעוד)."

