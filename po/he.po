#: ../fontforgeexe/fontinfo.c:4191
msgid "Deleting a layer cannot be UNDONE!"
msgstr "לא ניתן לבטל מחיקת שכבה!"

#: ../fontforgeexe/fontinfo.c:4192
msgid ""
"You are about to delete a layer.\n"
"This will lose all contours in that layer.\n"
"If this is the last quadratic layer it will\n"
"lose all truetype instructions.\n"
"\n"
"Deleting a layer cannot be undone.\n"
"\n"
"Is this really your intent?"
msgstr ""
"עומדת להימחק שכבה.\n"
"כל קווי המתאר בשכבה זו יאבדו.\n"
"אם זו השכבה הריבועית האחרונה,\n"
"כל הוראות ה־TrueType יאבדו.\n"
"\n"
"לא ניתן לבטל מחיקת שכבה.\n"
"\n"
"האם זו באמת כוונתך?"

#: ../fontforgeexe/fontinfo.c:4200
msgid "Removing instructions cannot be UNDONE!"
msgstr "לא ניתן לבטל הסרת הוראות!"

#: ../fontforgeexe/fontinfo.c:4201
msgid ""
"You are about to change the last quadratic\n"
"layer to cubic. When this happens FontForge\n"
"will remove all truetype instructions.\n"
"\n"
"This cannot be undone.\n"
"\n"
"Is this really your intent?"
msgstr ""
"עומדת להשתנות השכבה הריבועית האחרונה\n"
"לקובית. במקרה כזה FontForge\n"
"יסיר את כל הוראות ה־TrueType.\n"
"\n"
"לא ניתן לבטל פעולה זו.\n"
"\n"
"האם זו באמת כוונתך?"

