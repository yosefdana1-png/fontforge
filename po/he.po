#: ../fontforge/noprefs.c:190 ../fontforgeexe/prefs.c:302
#, c-format
msgid ""
"If you wish to replace Adobe's OtherSubrs array (for Type1 fonts)\n"
"with an array of your own, set this to point to a file containing\n"
"a list of up to 14 PostScript subroutines. Each subroutine must\n"
"be preceded by a line starting with '%%%%' (any text before the\n"
"first '%%%%' line will be treated as an initial copyright notice).\n"
"The first three subroutines are for flex hints, the next for hint\n"
"substitution (this MUST be present), the 14th (or 13 as the\n"
"numbering actually starts with 0) is for counter hints.\n"
"The subroutines should not be enclosed in a [ ] pair."
msgstr ""
"אם ברצונך להחליף את מערך OtherSubrs של Adobe (עבור גופני Type1)\n"
"במערך משלך, הגדר כאן קובץ שמכיל\n"
"רשימה של עד 14 שגרות PostScript. לפני כל שגרה\n"
"חייבת לבוא שורה שמתחילה ב-'%%%%' (כל טקסט שלפני\n"
"שורת ה-'%%%%' הראשונה ייחשב להודעת זכויות יוצרים פותחת).\n"
"שלוש השגרות הראשונות מיועדות ל-Hints מסוג flex, הבאה להחלפת\n"
"Hints (היא חייבת להיות קיימת), והשגרה ה-14 (או ה-13, כי\n"
"המספור מתחיל בפועל מ-0) מיועדת ל-Hints מסוג counter.\n"
"אין לתחום את השגרות בזוג [ ]."

#: ../fontforge/noprefs.c:190 ../fontforgeexe/prefs.c:302
msgid "OtherSubrsFile"
msgstr "קובץ OtherSubrs"

#: ../fontforge/noprefs.c:191 ../fontforgeexe/prefs.c:319
msgid ""
"Default encoding for\n"
"new fonts"
msgstr ""
"קידוד ברירת המחדל\n"
"לגופנים חדשים"

#: ../fontforge/noprefs.c:191 ../fontforgeexe/prefs.c:319
msgid "NewCharset"
msgstr "קידוד לגופנים חדשים"

#: ../fontforge/noprefs.c:192 ../fontforgeexe/prefs.c:320
msgid "NewEmSize"
msgstr "גודל em לגופנים חדשים"

#: ../fontforge/noprefs.c:192 ../fontforgeexe/prefs.c:320
msgid "The default size of the Em-Square in a newly created font."
msgstr "גודל ברירת המחדל של ריבוע ה-em בגופן חדש."

#: ../fontforge/noprefs.c:193 ../fontforgeexe/prefs.c:321
msgid "NewFontsQuadratic"
msgstr "גופנים חדשים ריבועיים"

#: ../fontforge/noprefs.c:193 ../fontforgeexe/prefs.c:321
msgid ""
"Whether new fonts should contain splines of quadratic (truetype)\n"
"or cubic (postscript & opentype)."
msgstr ""
"האם גופנים חדשים יכילו Splines ריבועיים (TrueType)\n"
"או מעוקבים (PostScript ו-OpenType)."

#: ../fontforge/noprefs.c:194 ../fontforgeexe/prefs.c:303
msgid "FreeTypeInFontView"
msgstr "FreeType בתצוגת הגופן"

#: ../fontforge/noprefs.c:194 ../fontforgeexe/prefs.c:303
msgid ""
"Use the FreeType rasterizer (when available)\n"
"to rasterize glyphs in the font view.\n"
"This generally results in better quality."
msgstr ""
"שימוש ברסטרייזר של FreeType (כשהוא זמין)\n"
"לרסטור גליפים בתצוגת הגופן.\n"
"בדרך כלל התוצאה איכותית יותר."

#: ../fontforge/noprefs.c:195 ../fontforgeexe/prefs.c:322
msgid "LoadedFontsAsNew"
msgstr "גופנים שנטענו כחדשים"

#: ../fontforge/noprefs.c:195 ../fontforgeexe/prefs.c:322
msgid ""
"Whether fonts loaded from the disk should retain their splines\n"
"with the original order (quadratic or cubic), or whether the\n"
"splines should be converted to the default order for new fonts\n"
"(see NewFontsQuadratic)."
msgstr ""
"האם גופנים שנטענים מהדיסק ישמרו את ה-Splines שלהם\n"
"בסדר המקורי (ריבועי או מעוקב), או שה-Splines\n"
"יומרו לסדר ברירת המחדל של גופנים חדשים\n"
"(ראה NewFontsQuadratic)."

#: ../fontforge/noprefs.c:196 ../fontforgeexe/prefs.c:326
msgid "PreferCJKEncodings"
msgstr "העדפת קידודי CJK"

#: ../fontforge/noprefs.c:196 ../fontforgeexe/prefs.c:326
msgid ""
"When loading a truetype or opentype font which has both a unicode\n"
"and a CJK encoding table, use this flag to specify which\n"
"should be loaded for the font."
msgstr ""
"בעת טעינת גופן TrueType או OpenType שיש בו גם טבלת קידוד Unicode\n"
"וגם טבלת קידוד CJK, השתמש בדגל זה כדי לציין איזו מהן\n"
"תיטען עבור הגופן."

#: ../fontforge/noprefs.c:197 ../fontforgeexe/prefs.c:327
msgid "AskUserForCMap"
msgstr "לשאול את המשתמש על cmap"

#: ../fontforge/noprefs.c:197 ../fontforgeexe/prefs.c:327
msgid ""
"When loading a font in sfnt format (TrueType, OpenType, etc.),\n"
"ask the user to specify which cmap to use initially."
msgstr ""
"בעת טעינת גופן בתבנית sfnt (TrueType, OpenType וכו'),\n"
"לבקש מהמשתמש לציין באיזה cmap להשתמש בתחילה."

#: ../fontforge/noprefs.c:198 ../fontforgeexe/prefs.c:328
msgid ""
"Enter a list of 4 letter table tags, separated by commas.\n"
"FontForge will make a binary copy of these tables when it\n"
"loads a True/OpenType font, and will output them (unchanged)\n"
"when it generates the font. Do not include table tags which\n"
"FontForge thinks it understands."
msgstr ""
"הזן רשימה של תגי טבלאות בני 4 אותיות, מופרדים בפסיקים.\n"
"FontForge ייצור עותק בינארי של טבלאות אלה כשהוא\n"
"טוען גופן TrueType/OpenType, ויפלוט אותן (ללא שינוי)\n"
"כשהוא יוצר את הגופן. אל תכלול תגי טבלאות\n"
"ש-FontForge סבור שהוא מבין."

#: ../fontforge/noprefs.c:198 ../fontforgeexe/prefs.c:328
msgid "PreserveTables"
msgstr "טבלאות לשימור"

#: ../fontforge/noprefs.c:199 ../fontforgeexe/prefs.c:332
msgid "OpenTypeLoadHintEqualityTolerance"
msgstr "סף שוויון Hints בטעינת OpenType"

#: ../fontforge/noprefs.c:199 ../fontforgeexe/prefs.c:332
msgid ""
"When importing an OpenType font, for the purposes of hinting spline points might not exactly match boundaries. For example, a point might be -0.0002 instead of exactly 0\n"
"This setting gives the user some control over this allowing a small tolerance value to be fed into the OpenType loading code.\n"
"Comparisons are then not performed for raw equality but for equality within tolerance (e.g., values within the range -0.0002 to 0.0002 will be considered equal to 0 when figuring out hints)."
msgstr ""
"בעת ייבוא גופן OpenType, לצורך Hinting, ייתכן שנקודות ה-Spline לא יתאימו בדיוק לגבולות. לדוגמה, נקודה עשויה להיות ב-‎-0.0002 במקום בדיוק ב-0\n"
"הגדרה זו מאפשרת למשתמש שליטה מסוימת בכך, באמצעות ערך סף קטן שמועבר לקוד הטעינה של OpenType.\n"
"ההשוואות אינן נעשות לשוויון מדויק אלא לשוויון בתוך הסף (לדוגמה, ערכים בטווח ‎-0.0002 עד 0.0002 ייחשבו שווים ל-0 בעת חישוב ה-Hints)."

#: ../fontforge/noprefs.c:200 ../fontforgeexe/prefs.c:342
msgid "In the Outline View, the Shift key constrains motion to be parallel to the ItalicAngle rather than constraining it to be vertical."
msgstr "בתצוגת קווי המתאר, מקש Shift מגביל את התנועה כך שתהיה מקבילה ל-ItalicAngle במקום להגביל אותה לתנועה אנכית."

#: ../fontforge/noprefs.c:200 ../fontforgeexe/prefs.c:342
msgid "ItalicConstrained"
msgstr "הגבלה לזווית הנטייה"

#: ../fontforge/noprefs.c:201 ../fontforgeexe/prefs.c:346
msgid "SnapToInt"
msgstr "הצמדה למספרים שלמים"

#: ../fontforge/noprefs.c:201 ../fontforgeexe/prefs.c:346
msgid "When the user clicks in the editing window, round the location to the nearest integers."
msgstr "כשהמשתמש לוחץ בחלון העריכה, המיקום יעוגל למספרים השלמים הקרובים."

#: ../fontforge/noprefs.c:202 ../fontforgeexe/prefs.c:348
msgid "JoinSnap"
msgstr "מרחק הצמדה לחיבור"

#: ../fontforge/noprefs.c:202 ../fontforgeexe/prefs.c:348
msgid ""
"The Edit->Join command will join points which are this close together\n"
"A value of 0 means they must be coincident"
msgstr ""
"הפקודה עריכה->חיבור תחבר נקודות שקרובות זו לזו במרחק זה\n"
"ערך 0 פירושו שהן חייבות להיות חופפות"

#: ../fontforge/noprefs.c:203 ../fontforgeexe/prefs.c:349
msgid "CopyMetaData"
msgstr "העתקת מטא-נתונים"

#: ../fontforge/noprefs.c:203 ../fontforge/noprefs.c:208 ../fontforgeexe/prefs.c:349
msgid ""
"When copying glyphs from the font view, also copy the\n"
"glyphs' metadata (name, encoding, comment, etc)."
msgstr ""
"בעת העתקת גליפים מתצוגת הגופן, להעתיק גם את\n"
"המטא-נתונים של הגליפים (שם, קידוד, הערה וכו')."

#: ../fontforge/noprefs.c:204
msgid "The maximum number of Undoes/Redoes stored in a glyph"
msgstr "המספר המרבי של פעולות ביטול/ביצוע חוזר שנשמרות בגליף"

#: ../fontforge/noprefs.c:204 ../fontforgeexe/prefs.c:350
msgid "UndoDepth"
msgstr "עומק ביטול"

#: ../fontforge/noprefs.c:205 ../fontforgeexe/prefs.c:370
msgid "AutoWidthSync"
msgstr "סנכרון רוחב אוטומטי"

#: ../fontforge/noprefs.c:205 ../fontforgeexe/prefs.c:370
msgid ""
"Changing the width of a glyph\n"
"changes the widths of all accented\n"
"glyphs based on it."
msgstr ""
"שינוי הרוחב של גליף\n"
"משנה את הרוחב של כל הגליפים\n"
"עם סימנים דיאקריטיים המבוססים עליו."

#: ../fontforge/noprefs.c:206 ../fontforgeexe/prefs.c:371
msgid "AutoLBearingSync"
msgstr "סנכרון LBearing אוטומטי"

#: ../fontforge/noprefs.c:206 ../fontforgeexe/prefs.c:371
msgid ""
"Changing the left side bearing\n"
"of a glyph adjusts the lbearing\n"
"of other references in all accented\n"
"glyphs based on it."
msgstr ""
"שינוי ה-Bearing השמאלי\n"
"של גליף מתאים את ה-lbearing\n"
"של הפניות אחרות בכל הגליפים\n"
"עם סימנים דיאקריטיים המבוססים עליו."

#: ../fontforge/noprefs.c:207 ../fontforgeexe/prefs.c:375
msgid "ClearInstrsBigChanges"
msgstr "מחיקת הוראות בשינויים גדולים"

#: ../fontforge/noprefs.c:207 ../fontforgeexe/prefs.c:375
msgid ""
"Instructions in a TrueType font refer to\n"
"points by number, so if you edit a glyph\n"
"in such a way that some points have different\n"
"numbers (add points, remove them, etc.) then\n"
"the instructions will be applied to the wrong\n"
"points with disastrous results.\n"
"  Normally FontForge will remove the instructions\n"
"if it detects that the points have been renumbered\n"
"in order to avoid the above problem. You may turn\n"
"this behavior off -- but be careful!"
msgstr ""
"הוראות בגופן TrueType מתייחסות\n"
"לנקודות לפי מספר, כך שאם עורכים גליף\n"
"באופן שגורם לחלק מהנקודות לקבל מספרים\n"
"שונים (הוספת נקודות, הסרתן וכו'), ההוראות\n"
"יוחלו על הנקודות הלא נכונות\n"
"עם תוצאות הרות אסון.\n"
"  בדרך כלל FontForge יסיר את ההוראות\n"
"אם יזהה שהנקודות מוספרו מחדש,\n"
"כדי למנוע את הבעיה שלעיל. ניתן לכבות\n"
"התנהגות זו -- אבל יש להיזהר!"

#: ../fontforge/noprefs.c:208 ../fontforgeexe/prefs.c:376
msgid "CopyTTFInstrs"
msgstr "העתקת הוראות TTF"

#: ../fontforge/noprefs.c:209 ../fontforgeexe/prefs.c:380
msgid "AccentOffsetPercent"
msgstr "אחוז היסט סימן דיאקריטי"

#: ../fontforge/noprefs.c:209 ../fontforgeexe/prefs.c:380
msgid "The percentage of an em by which an accent is offset from its base glyph in Build Accent"
msgstr "האחוז מה-em שבו סימן דיאקריטי מוסט מגליף הבסיס שלו בבניית סימנים דיאקריטיים"

#: ../fontforge/noprefs.c:210 ../fontforgeexe/prefs.c:381
msgid "AccentCenterLowest"
msgstr "מרכוז סימן לפי הנקודה הנמוכה"

#: ../fontforge/noprefs.c:210 ../fontforgeexe/prefs.c:381 ../fontforgeexe/prefs.c:528
msgid ""
"When placing grave and acute accents above letters, should\n"
"FontForge center them based on their full width, or\n"
"should it just center based on the lowest point\n"
"of the accent."
msgstr ""
"בעת מיקום סימני grave ו-acute מעל אותיות, האם\n"
"FontForge ימרכז אותם לפי מלוא רוחבם, או\n"
"שימרכז רק לפי הנקודה הנמוכה ביותר\n"
"של הסימן."

#: ../fontforge/noprefs.c:211 ../fontforgeexe/prefs.c:382
msgid "CharCenterHighest"
msgstr "מרכוז לפי הנקודה הגבוהה של התו"

#: ../fontforge/noprefs.c:211 ../fontforgeexe/prefs.c:382
msgid ""
"When centering an accent over a glyph, should the accent\n"
"be centered on the highest point(s) of the glyph,\n"
"or the middle of the glyph?"
msgstr ""
"בעת מרכוז סימן דיאקריטי מעל גליף, האם הסימן\n"
"ימורכז מעל הנקודה (או הנקודות) הגבוהה ביותר של הגליף,\n"
"או מעל אמצע הגליף?"

#: ../fontforge/noprefs.c:212 ../fontforgeexe/prefs.c:383
msgid "PreferSpacingAccents"
msgstr "העדפת סימנים דיאקריטיים מרווחים"

#: ../fontforge/noprefs.c:212 ../fontforgeexe/prefs.c:383
msgid ""
"Use spacing accents (Unicode: 02C0-02FF) rather than\n"
"combining accents (Unicode: 0300-036F) when\n"
"building accented glyphs."
msgstr ""
"שימוש בסימנים דיאקריטיים מרווחים (Unicode: 02C0-02FF) במקום\n"
"בסימנים דיאקריטיים מצטרפים (Unicode: 0300-036F) בעת\n"
"בניית גליפים עם סימנים דיאקריטיים."

#: ../fontforge/noprefs.c:213 ../fontforgeexe/prefs.c:387
msgid ""
"FontForge supports two different helper applications to do autotracing\n"
" autotrace and potrace\n"
"If your system only has one it will use that one, if you have both\n"
"use this option to tell FontForge which to pick."
msgstr ""
"FontForge תומך בשתי תוכנות עזר שונות למעקב אוטומטי\n"
" autotrace ו-potrace\n"
"אם במערכת שלך קיימת רק אחת מהן, ייעשה בה שימוש; אם שתיהן קיימות,\n"
"השתמש באפשרות זו כדי לומר ל-FontForge באיזו לבחור."

#: ../fontforge/noprefs.c:213 ../fontforgeexe/prefs.c:387
msgid "PreferPotrace"
msgstr "העדפת potrace"

#: ../fontforge/noprefs.c:214 ../fontforgeexe/prefs.c:388
msgid "AutotraceArgs"
msgstr "ארגומנטים ל-autotrace"

#: ../fontforge/noprefs.c:214 ../fontforgeexe/prefs.c:388
msgid ""
"Extra arguments for configuring the autotrace program\n"
"(either autotrace or potrace)"
msgstr ""
"ארגומנטים נוספים להגדרת תוכנת המעקב האוטומטי\n"
"(autotrace או potrace)"

#: ../fontforge/noprefs.c:215 ../fontforgeexe/prefs.c:389
msgid "Ask the user for autotrace arguments each time autotrace is invoked"
msgstr "לבקש מהמשתמש ארגומנטים למעקב אוטומטי בכל הפעלה של המעקב האוטומטי"

#: ../fontforge/noprefs.c:215 ../fontforgeexe/prefs.c:389
msgid "AutotraceAsk"
msgstr "לשאול על ארגומנטים ל-autotrace"

#: ../fontforge/noprefs.c:216 ../fontforgeexe/prefs.c:390
msgid "Commands to pass to mf (metafont) program, the filename will follow these"
msgstr "פקודות שיועברו לתוכנת mf (METAFONT); שם הקובץ יבוא אחריהן"

#: ../fontforge/noprefs.c:216 ../fontforgeexe/prefs.c:390
msgid "MfArgs"
msgstr "ארגומנטים ל-mf"

#: ../fontforge/noprefs.c:217 ../fontforgeexe/prefs.c:391
msgid "Ask the user for mf commands each time mf is invoked"
msgstr "לבקש מהמשתמש פקודות mf בכל הפעלה של mf"

#: ../fontforge/noprefs.c:217 ../fontforgeexe/prefs.c:391
msgid "MfAsk"
msgstr "לשאול על פקודות mf"

#: ../fontforge/noprefs.c:218 ../fontforgeexe/prefs.c:392
msgid ""
"FontForge loads large images into the background of each glyph\n"
"prior to autotracing them. You may retain those\n"
"images to look at after mf processing is complete, or\n"
"remove them to save space"
msgstr ""
"FontForge טוען תמונות גדולות לרקע של כל גליף\n"
"לפני המעקב האוטומטי אחריהן. ניתן לשמור את\n"
"התמונות כדי לעיין בהן אחרי סיום עיבוד mf, או\n"
"להסיר אותן כדי לחסוך מקום"

#: ../fontforge/noprefs.c:218 ../fontforgeexe/prefs.c:392
msgid "MfClearBg"
msgstr "מחיקת רקע אחרי mf"

#: ../fontforge/noprefs.c:219 ../fontforgeexe/prefs.c:393
msgid ""
"MetaFont (mf) generates lots of verbiage to stdout.\n"
"Most of the time I find it an annoyance but it is\n"
"important to see if something goes wrong."
msgstr ""
"METAFONT (mf) מפיק פלט מילולי רב ל-stdout.\n"
"רוב הזמן אני מוצא זאת מטריד, אבל\n"
"חשוב לראות אם משהו משתבש."

#: ../fontforge/noprefs.c:219 ../fontforgeexe/prefs.c:393
msgid "MfShowErr"
msgstr "הצגת שגיאות mf"

#: ../fontforge/noprefs.c:220 ../fontforgeexe/prefs.c:397
msgid "FoundryName"
msgstr "שם היצרן"

#: ../fontforge/noprefs.c:220 ../fontforgeexe/prefs.c:397
msgid ""
"Name used for foundry field in bdf\n"
"font generation"
msgstr ""
"השם שישמש בשדה foundry ביצירת\n"
"גופני BDF"

#: ../fontforge/noprefs.c:221 ../fontforgeexe/prefs.c:398
msgid ""
"Name used for Vendor ID field in\n"
"ttf (OS/2 table) font generation.\n"
"Must be no more than 4 characters"
msgstr ""
"השם שישמש בשדה Vendor ID ביצירת\n"
"גופני TTF (טבלת OS/2).\n"
"לכל היותר 4 תווים"

#: ../fontforge/noprefs.c:221 ../fontforgeexe/prefs.c:398
msgid "TTFFoundry"
msgstr "יצרן TTF"

#: ../fontforge/noprefs.c:222 ../fontforgeexe/prefs.c:399
msgid ""
"FontForge will use this namelist when assigning\n"
"glyph names to code points in a new font."
msgstr ""
"FontForge ישתמש ב-NameList זה בעת הקצאת\n"
"שמות גליפים לנקודות קוד בגופן חדש."

#: ../fontforge/noprefs.c:222 ../fontforgeexe/prefs.c:399
msgid "NewFontNameList"
msgstr "NameList לגופן חדש"

#: ../fontforge/noprefs.c:223 ../fontforgeexe/prefs.c:400
msgid ""
"Once upon a time, Adobe assigned PUA (public use area) encodings\n"
"for many stylistic variants of characters (small caps, old style\n"
"numerals, etc.). Adobe no longer believes this to be a good idea,\n"
"and recommends that these encodings be ignored.\n"
"\n"
" The assignments were originally made because most applications\n"
"could not handle OpenType features for accessing variants. Adobe\n"
"now believes that all apps that matter can now do so. Applications\n"
"like Word and OpenOffice still can't handle these features, so\n"
" fontforge's default behavior is to ignore Adobe's current\n"
"recommendations.\n"
"\n"
"Note: This does not affect figuring out unicode from the font's encoding,\n"
"it just controls determining unicode from a name."
msgstr ""
"פעם, Adobe הקצתה קידודי PUA (אזור לשימוש פרטי)\n"
"לווריאנטים סגנוניים רבים של תווים (רישיות קטנות, ספרות\n"
"בסגנון ישן וכו'). Adobe כבר אינה סבורה שזה רעיון טוב,\n"
"וממליצה להתעלם מקידודים אלה.\n"
"\n"
" ההקצאות נעשו במקור משום שרוב היישומים\n"
"לא ידעו לטפל ב-Features של OpenType לגישה לווריאנטים. Adobe\n"
"סבורה כיום שכל היישומים החשובים יודעים לעשות זאת. יישומים\n"
"כמו Word ו-OpenOffice עדיין אינם יודעים לטפל ב-Features אלה, ולכן\n"
" התנהגות ברירת המחדל של FontForge היא להתעלם מההמלצות\n"
"הנוכחיות של Adobe.\n"
"\n"
"הערה: הדבר אינו משפיע על זיהוי Unicode מתוך הקידוד של הגופן,\n"
"הוא קובע רק את זיהוי Unicode מתוך שם."

#: ../fontforge/noprefs.c:223 ../fontforgeexe/prefs.c:400
msgid "RecognizePUANames"
msgstr "זיהוי שמות PUA"

#: ../fontforge/noprefs.c:224 ../fontforgeexe/prefs.c:401
msgid ""
"Allow the full unicode character set in glyph names.\n"
"This does not conform to adobe's glyph name standard.\n"
"Such names should be for internal use only and\n"
"should NOT end up in production fonts."
msgstr ""
"התרת כל ערכת התווים של Unicode בשמות גליפים.\n"
"הדבר אינו תואם לתקן שמות הגליפים של Adobe.\n"
"שמות כאלה מיועדים לשימוש פנימי בלבד\n"
"ואסור שיגיעו לגופנים בייצור."

#: ../fontforge/noprefs.c:224 ../fontforgeexe/prefs.c:401
msgid "UnicodeGlyphNames"
msgstr "שמות גליפים ב-Unicode"

#: ../fontforge/noprefs.c:225 ../fontforgeexe/prefs.c:518
msgid ""
"If specified this should be a space separated list of integers each\n"
"less than 16777216 which uniquely identify your organization\n"
"FontForge will generate a random number for the final component."
msgstr ""
"אם צוין, זו אמורה להיות רשימה מופרדת ברווחים של מספרים שלמים, כל אחד\n"
"קטן מ-16777216, המזהים באופן ייחודי את הארגון שלך\n"
"FontForge ייצור מספר אקראי לרכיב האחרון."

#: ../fontforge/noprefs.c:225
msgid "XUID-Base"
msgstr "בסיס XUID"

#: ../fontforge/noprefs.c:226 ../fontforge/noprefs.c:275 ../fontforgeexe/prefs.c:406
msgid "AskBDFResolution"
msgstr "לשאול על רזולוציית BDF"

#: ../fontforge/noprefs.c:226 ../fontforge/noprefs.c:275 ../fontforgeexe/prefs.c:406
msgid ""
"When generating a set of BDF fonts ask the user\n"
"to specify the screen resolution of the fonts\n"
"otherwise FontForge will guess depending on the pixel size."
msgstr ""
"בעת יצירת קבוצה של גופני BDF, לבקש מהמשתמש\n"
"לציין את רזולוציית המסך של הגופנים,\n"
"אחרת FontForge ינחש לפי גודל הפיקסלים."

#: ../fontforge/noprefs.c:227 ../fontforgeexe/prefs.c:407
msgid "AutoHint"
msgstr "Hinting אוטומטי"

#: ../fontforge/noprefs.c:227 ../fontforgeexe/prefs.c:407
msgid "AutoHint changed glyphs before generating a font"
msgstr "הפעלת Hinting אוטומטי על גליפים ששונו לפני יצירת גופן"

#: ../fontforge/noprefs.c:229 ../fontforgeexe/prefs.c:409
msgid "If your SFD contains images, write them as PNG; this results in smaller SFDs; but was not supported in FontForge versions compiled before July 2019, so older FontForge versions cannot read them."
msgstr "אם קובץ ה-SFD מכיל תמונות, לכתוב אותן כ-PNG; כך מתקבלים קובצי SFD קטנים יותר, אבל הדבר לא נתמך בגרסאות FontForge שהודרו לפני יולי 2019, ולכן גרסאות FontForge ישנות יותר לא יוכלו לקרוא אותם."

#: ../fontforge/noprefs.c:229 ../fontforgeexe/prefs.c:409
msgid "WritePNGInSFD"
msgstr "כתיבת PNG ב-SFD"

#: ../fontforge/noprefs.c:231 ../fontforgeexe/prefs.c:412
msgid "GenerateHintWidthEqualityTolerance"
msgstr "סף שוויון רוחב Hints ביצירה"

#: ../fontforge/noprefs.c:231 ../fontforgeexe/prefs.c:412
msgid "When generating a font, ignore slight rounding errors for hints that should be at the top or bottom of the glyph. For example, you might like to set this to 0.02 so that 19.999 will be considered 20. But only for the hint width value."
msgstr "בעת יצירת גופן, להתעלם משגיאות עיגול קלות ב-Hints שאמורים להיות בראש הגליף או בתחתיתו. לדוגמה, ייתכן שתרצה להגדיר ערך 0.02 כך ש-19.999 ייחשב ל-20. אבל רק עבור ערך הרוחב של ה-Hint."

#: ../fontforge/noprefs.c:232 ../fontforgeexe/prefs.c:419
msgid "FontForge will place vertical or horizontal hints to describe the bounding boxes of suitable glyphs."
msgstr "FontForge ימקם Hints אנכיים או אופקיים כדי לתאר את התיבות התוחמות של גליפים מתאימים."

#: ../fontforge/noprefs.c:232 ../fontforgeexe/prefs.c:419
msgid "HintBoundingBoxes"
msgstr "Hints לתיבות תוחמות"

#: ../fontforge/noprefs.c:233 ../fontforgeexe/prefs.c:420
msgid "FontForge will place vertical or horizontal hints at the ends of diagonal stems."
msgstr "FontForge ימקם Hints אנכיים או אופקיים בקצות גבעולים אלכסוניים."

#: ../fontforge/noprefs.c:233 ../fontforgeexe/prefs.c:420
msgid "HintDiagonalEnds"
msgstr "Hints לקצות אלכסונים"

#: ../fontforge/noprefs.c:234 ../fontforgeexe/prefs.c:421
msgid "FontForge will place vertical or horizontal hints at the intersections of diagonal stems."
msgstr "FontForge ימקם Hints אנכיים או אופקיים בנקודות החיתוך של גבעולים אלכסוניים."

#: ../fontforge/noprefs.c:234 ../fontforgeexe/prefs.c:421
msgid "HintDiagonalInter"
msgstr "Hints לחיתוכי אלכסונים"

#: ../fontforge/noprefs.c:235 ../fontforgeexe/prefs.c:422
msgid "DetectDiagonalStems"
msgstr "זיהוי גבעולים אלכסוניים"

#: ../fontforge/noprefs.c:235 ../fontforgeexe/prefs.c:422
msgid "FontForge will generate diagonal stem hints, which then can be used by the AutoInstr command."
msgstr "FontForge ייצור Hints לגבעולים אלכסוניים, שבהם יוכל להשתמש לאחר מכן הפקודה AutoInstr."

#: ../fontforge/noprefs.c:236 ../fontforgeexe/prefs.c:434
msgid ""
"MS has changed (in August 2006) the inner workings of their Indic shaping\n"
"engine, and to disambiguate this change has created a parallel set of script\n"
"tags (generally ending in '2') for Indic writing systems. If you are working\n"
"with the new system set this flag, if you are working with the old unset it.\n"
"(if you aren't doing Indic work, this flag is irrelevant)."
msgstr ""
"MS שינתה (באוגוסט 2006) את אופן הפעולה הפנימי של מנוע העיצוב ההודי שלה,\n"
"וכדי להבחין בשינוי זה יצרה קבוצה מקבילה של תגי\n"
"כתב (שבדרך כלל מסתיימים ב-'2') עבור מערכות כתב הודיות. אם אתה עובד\n"
"עם המערכת החדשה, הפעל דגל זה; אם אתה עובד עם הישנה, כבה אותו.\n"
"(אם אינך עובד עם כתבים הודיים, דגל זה אינו רלוונטי)."

#: ../fontforge/noprefs.c:236 ../fontforgeexe/prefs.c:434
msgid "UseNewIndicScripts"
msgstr "שימוש בכתבים הודיים חדשים"

#: ../fontforge/noprefs.c:238 ../fontforgeexe/prefs.c:313
msgid "UsePlugins"
msgstr "שימוש בתוספים"

#: ../fontforge/noprefs.c:238 ../fontforgeexe/prefs.c:313
msgid "Whether or not to try to discover and import Python plugins."
msgstr "האם לנסות לאתר ולייבא תוספי Python."

#. GT: The following strings have no spaces and an odd capitalization
#. GT: this is because these strings are used in two different ways, one
#. GT: translated (which the user sees, and should probably have added spaces,
#. GT: and one untranslated which needs the current odd format
#: ../fontforge/noprefs.c:265 ../fontforgeexe/prefs.c:301
msgid "ResourceFile"
msgstr "קובץ משאבים"

#: ../fontforge/noprefs.c:265 ../fontforgeexe/prefs.c:301
msgid ""
"When FontForge starts up, it loads the user interface theme from\n"
"this file. Any changes will only take effect the next time you start FontForge."
msgstr ""
"בעת ההפעלה, FontForge טוען את ערכת הנושא של ממשק המשתמש\n"
"מקובץ זה. שינויים ייכנסו לתוקף רק בהפעלה הבאה של FontForge."

#: ../fontforge/noprefs.c:266 ../fontforgeexe/prefs.c:305
msgid "Show splash screen on start-up"
msgstr "הצגת מסך פתיחה בהפעלה"

#: ../fontforge/noprefs.c:266 ../fontforgeexe/prefs.c:305
msgid "SplashScreen"
msgstr "מסך פתיחה"

#: ../fontforge/noprefs.c:267 ../fontforgeexe/prefs.c:336
msgid "GlyphAutoGoto"
msgstr "מעבר אוטומטי לגליף"

#: ../fontforge/noprefs.c:267
msgid "Typing a normal character in the glyph view window changes the window to look at that character"
msgstr "הקלדת תו רגיל בחלון תצוגת הגליף מעבירה את החלון להצגת אותו תו"

#: ../fontforge/noprefs.c:268 ../fontforgeexe/prefs.c:337
msgid "OpenCharsInNewWindow"
msgstr "פתיחת תווים בחלון חדש"

#: ../fontforge/noprefs.c:268 ../fontforgeexe/prefs.c:337
msgid ""
"When double clicking on a character in the font view\n"
"open that character in a new window, otherwise\n"
"reuse an existing one."
msgstr ""
"בלחיצה כפולה על תו בתצוגת הגופן,\n"
"לפתוח את התו בחלון חדש; אחרת\n"
"להשתמש מחדש בחלון קיים."

#: ../fontforge/noprefs.c:269 ../fontforgeexe/prefs.c:338
msgid "FontViewMetricsViewSelectMax"
msgstr "מרב גליפים נבחרים לחלון המדדים"

#: ../fontforge/noprefs.c:269 ../fontforgeexe/prefs.c:338
msgid "When characters are selected in the FontView, how many should be put into the MetricsView if you open one? Negative values mean there's no limit, which should be used sparingly."
msgstr "כשתווים נבחרים בתצוגת הגופן, כמה מהם יוכנסו לחלון המדדים אם תפתח אחד? ערכים שליליים פירושם שאין מגבלה, ויש להשתמש בהם במשורה."

#: ../fontforge/noprefs.c:270 ../fontforgeexe/prefs.c:358 ../fontforgeexe/prefs.c:2496
msgid "ArrowMoveSize"
msgstr "גודל הזזה בחיצים"

#: ../fontforge/noprefs.c:270 ../fontforgeexe/prefs.c:358 ../fontforgeexe/prefs.c:2496
msgid "The number of em-units by which an arrow key will move a selected point"
msgstr "מספר יחידות ה-em שבהן מקש חץ יזיז נקודה נבחרת"

#: ../fontforge/noprefs.c:271 ../fontforgeexe/prefs.c:359 ../fontforgeexe/prefs.c:2497
msgid "ArrowAccelFactor"
msgstr "מקדם האצת חיצים"

#: ../fontforge/noprefs.c:271 ../fontforgeexe/prefs.c:359 ../fontforgeexe/prefs.c:2497
msgid "Holding down the Shift key will speed up arrow key motion by this factor"
msgstr "החזקת מקש Shift תאיץ את תנועת מקשי החצים בגורם זה"

#: ../fontforge/noprefs.c:272 ../fontforgeexe/prefs.c:344
msgid "SnapDistance"
msgstr "מרחק הצמדה"

#: ../fontforge/noprefs.c:272 ../fontforgeexe/prefs.c:344
msgid ""
"When the mouse pointer is within this many pixels\n"
"of one of the various interesting features (baseline,\n"
"width, grid splines, etc.) the pointer will snap\n"
"to that feature."
msgstr ""
"כשסמן העכבר נמצא במרחק של פיקסלים כאלה\n"
"מאחד מהרכיבים המעניינים (קו בסיס,\n"
"רוחב, Splines של רשת וכו'), הסמן ייצמד\n"
"לאותו רכיב."

#: ../fontforge/noprefs.c:273 ../fontforgeexe/prefs.c:347
msgid "StopAtJoin"
msgstr "עצירה בחיבור"

#: ../fontforge/noprefs.c:273 ../fontforgeexe/prefs.c:347
msgid ""
"When dragging points in the outline view a join may occur\n"
"(two open contours may connect at their endpoints). When\n"
"this is On a join will cause FontForge to stop moving the\n"
"selection (as if the user had released the mouse button).\n"
"This is handy if your fingers are inclined to wiggle a bit."
msgstr ""
"בעת גרירת נקודות בתצוגת קווי המתאר עשוי להתרחש חיבור\n"
"(שני קווי מתאר פתוחים עשויים להתחבר בנקודות הקצה שלהם). כשאפשרות\n"
"זו מופעלת, חיבור יגרום ל-FontForge להפסיק להזיז את\n"
"הבחירה (כאילו המשתמש שחרר את לחצן העכבר).\n"
"זה שימושי אם האצבעות שלך נוטות לרעוד מעט."

#: ../fontforge/noprefs.c:274 ../fontforgeexe/prefs.c:351
msgid "Figure out flex hints after every change"
msgstr "חישוב Hints מסוג flex אחרי כל שינוי"

#: ../fontforge/noprefs.c:274 ../fontforgeexe/prefs.c:351
msgid "UpdateFlex"
msgstr "עדכון flex"

#: ../fontforge/noprefs.c:289 ../fontforgeexe/prefs.c:460
msgid "Display rulers in the Outline Glyph View"
msgstr "הצגת סרגלים בתצוגת קווי המתאר של הגליף"

#: ../fontforge/nowakowskittfinstr.c:759
msgid "Can't insert 'cvt'"
msgstr "לא ניתן להוסיף 'cvt'"

#: ../fontforge/nowakowskittfinstr.c:760
msgid "There already exists a 'cvt' table, perhaps legacy. FontForge can use it, but can't make any assumptions on values stored there, so generated instructions will be of lower quality. If legacy hinting is to be scrapped, it is suggested to clear the `cvt` and repeat autoinstructing. "
msgstr "כבר קיימת טבלת 'cvt', אולי מדור קודם. FontForge יכול להשתמש בה, אך אינו יכול להניח דבר לגבי הערכים השמורים בה, ולכן ההוראות שייווצרו יהיו באיכות נמוכה יותר. אם יש לוותר על ה-Hinting הקודם, מומלץ למחוק את `cvt` ולהריץ שוב את יצירת ההוראות האוטומטית. "

#: ../fontforge/nowakowskittfinstr.c:1647
msgid "Can't insert 'fpgm'"
msgstr "לא ניתן להוסיף 'fpgm'"

#: ../fontforge/nowakowskittfinstr.c:1648
msgid "There exists a 'fpgm' code that seems incompatible with FontForge's. Instructions generated will be of lower quality. If legacy hinting is to be scrapped, it is suggested to clear the `fpgm` and repeat autoinstructing. It will be then possible to append user's code to FontForge's 'fpgm', but due to possible future updates, it is extremely advised to use high numbers for user's functions."
msgstr "קיים קוד 'fpgm' שנראה לא תואם לזה של FontForge. ההוראות שייווצרו יהיו באיכות נמוכה יותר. אם יש לוותר על ה-Hinting הקודם, מומלץ למחוק את `fpgm` ולהריץ שוב את יצירת ההוראות האוטומטית. לאחר מכן ניתן יהיה להוסיף את קוד המשתמש ל-'fpgm' של FontForge, אך בשל עדכונים עתידיים אפשריים, מומלץ מאוד להשתמש במספרים גבוהים עבור פונקציות המשתמש."

#: ../fontforge/nowakowskittfinstr.c:1964
msgid "Can't insert 'prep'"
msgstr "לא ניתן להוסיף 'prep'"

#: ../fontforge/nowakowskittfinstr.c:1965
msgid "There exists a 'prep' code incompatible with FontForge's. It can't be guaranteed it will work well. It is suggested to allow FontForge to insert its code and then append user's own."
msgstr "קיים קוד 'prep' שאינו תואם לזה של FontForge. לא ניתן להבטיח שהוא יעבוד היטב. מומלץ לאפשר ל-FontForge להוסיף את הקוד שלו ולאחר מכן להוסיף את קוד המשתמש."

